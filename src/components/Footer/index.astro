---
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="footer-content">
      <div class="copyright">
        &copy; {year} 资源中心. 保留所有权利.
      </div>
      <div class="links">
        <a href="/privacy">隐私政策</a>
        <a href="/terms">使用条款</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    background-color: var(--footer-bg);
    border-top: 1px solid var(--border-color);
    padding: 2rem 0;
    margin-top: auto;
  }

  .footer-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .copyright {
    color: var(--text-color-secondary);
    font-size: 0.875rem;
  }

  .links {
    display: flex;
    gap: 1.5rem;
  }

  .links a {
    color: var(--text-color-secondary);
    font-size: 0.875rem;
    text-decoration: none;
    transition: color var(--transition-normal);
  }

  .links a:hover {
    color: var(--text-color);
  }

  @media (max-width: 640px) {
    .footer-content {
      flex-direction: column;
      gap: 1rem;
      text-align: center;
    }
  }
</style>

